# Copy this file to ".env" (same folder) and edit. Lines starting with # are ignored.

# --- Option A: SQLite (default, nothing to install) ---
# DATABASE_URL=sqlite:///./campusnest.db

# --- Option B: PostgreSQL (open it in DBeaver) ---
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/campusnest

SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
